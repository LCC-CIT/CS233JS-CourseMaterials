  "analysis": {
    "features": [
      {
        "id": "modules",
        "match": {
          "allOf": [
            {
              "regex": "import\\s+.*from"
            },
            {
              "regex": "export\\s+"
            }
          ]
        },
        "fileRegex": "\\.m?js$"
      },
      {
        "id": "arrowFunctions",
        "regex": "=>",
        "fileRegex": "\\.js$"
      },
      {
        "id": "defaultParams",
        "regex": "\\([^\\)]*?[a-zA-Z0-9_$]+\\s*=[^=].*?\\)",
        "fileRegex": "\\.js$"
      },
      {
        "id": "destructuring",
        "regex": "(const|let|var)\\s*(\\{.*?\\}|\\[.*?\\])\\s*=",
        "fileRegex": "\\.js$"
      },
      {
        "id": "templateStrings",
        "regex": "`",
        "fileRegex": "\\.js$"
      }
    ]
  },
