  "runtimeCheck": "both",
  "repoHygiene": {
    "excludedFromRepo": [
      "node_modules",
      "dist",
      ".DS_Store"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      "dist"
    ]
  },
  "analysis": {
    "features": [
      {
        "id": "canvas_context",
        "regex": "getContext\\(['\"]2d['\"]\\)",
        "fileRegex": "\\.js$"
      },
      {
        "id": "local_storage",
        "regex": "localStorage",
        "fileRegex": "\\.js$"
      },
      {
        "id": "lena_js",
        "regex": "from\\s+['\"]lena",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_filter",
        "regex": "\\.filter\\s*=",
        "fileRegex": "\\.js$"
      },
      {
        "id": "module_imports",
        "regex": "import\\s+.*from",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_filtering",
        "regex": "(?:\\.filter\\s*=|from\\s+['\"]lena)",
        "fileRegex": "\\.js$"
      },
      {
        "id": "stroke_text",
        "regex": "\\bstrokeText\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_clip_shape",
        "regex": "\\b(?:arc|ellipse|roundRect)\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_advanced_feature",
        "regex": "\\b(?:scale|lineTo|drawImage)\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_styling",
        "regex": "(?:\\.fillStyle|\\.strokeStyle|\\.font)\\s*=",
        "fileRegex": "\\.js$"
      },
      {
        "id": "c12_feature_ok",
        "fileRegex": "\\.m?js$",
        "match": {
          "anyOf": [
            {
              "regex": "\\bscale\\("
            },
            {
              "allOf": [
                {
                  "regex": "\\blineTo\\("
                },
                {
                  "regex": "mousedown|mousemove"
                }
              ]
            },
            {
              "allOf": [
                {
                  "regex": "sticker",
                  "flags": "i"
                },
                {
                  "regex": "mousedown|mousemove"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "c13_feature_ok",
        "fileRegex": "\\.m?js$",
        "match": {
          "anyOf": [
            {
              "regex": "this\\.(?:bgColor|backgroundColor|canvasBg)\\s*="
            },
            {
              "regex": "this\\.#?(?:textColor|fontColor|fillColor|textFill|fontFillColor|fontFill)\\s*="
            },
            {
              "regex": "ctx\\.fillStyle\\s*=\\s*this\\.#?\\w"
            },
            {
              "regex": "this\\.#?(?:fontSelect|fontFamily|fontStyle|font)\\s*="
            }
          ]
        }
      }
    ]
  },
  "mappings": [
    {
